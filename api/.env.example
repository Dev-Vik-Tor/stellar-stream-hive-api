# Copy this file to `.env` (or export these as real environment variables) and
# adjust as needed. None of these are required to start the server -- every
# value has a safe default -- but STREAM_CONTRACT_ID in particular should be set
# for real as soon as the Stream contract has a deployment address.

# Horizon instance to poll. Defaults to public testnet.
HORIZON_URL=https://horizon-testnet.stellar.org

# The Stream contract's C... strkey address. Left as an obvious placeholder
# until the sister contracts repo (https://github.com/Stellar-Hive/stellar-stream-hive-contract)
# has a real deployment. Until this is set to a real C... address, the indexer
# still polls Horizon (so /health and /stats work) but cannot match or decode
# any stream contract events.
STREAM_CONTRACT_ID=CONTRACT_ID_NOT_YET_DEPLOYED_SET_STREAM_CONTRACT_ID_ENV_VAR

# Socket address the HTTP server binds to.
BIND_ADDR=0.0.0.0:8080

# How often (in seconds) the background indexer polls Horizon.
POLL_INTERVAL_SECS=10

# Browser origins allowed to call the API, comma separated, e.g.
# "https://app.example,https://staging.example". Leave unset (or "*") to allow
# any origin -- safe here because the API is read-only and uses no cookies.
# CORS_ALLOWED_ORIGINS=

# Log verbosity, passed straight to tracing-subscriber's EnvFilter, e.g.
# "info", "debug", or "stellar_stream_hive_api=debug,tower_http=debug".
RUST_LOG=info

# Copy this file to `.env` (or export these as real environment variables) and
# adjust as needed. None of these are required to start the server -- every
# value has a safe default -- but STREAM_CONTRACT_ID in particular should be set
# for real as soon as the Stream contract has a deployment address.

# Soroban RPC endpoint the indexer reads contract events from. Defaults to
# public testnet.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# How many ledgers behind the tip the first poll starts (5s per ledger, so
# 17280 is about a day). Must fit inside the RPC's event retention window.
INDEXER_BACKFILL_LEDGERS=17280

# The Stream contract's C... strkey address. This is the testnet deployment from
# 2026-10-12 (see DEPLOYMENTS.md in
# https://github.com/Stellar-Hive/stellar-stream-hive-contract). A redeploy
# creates a new id. If unset the indexer still runs (ledger tracking, /health,
# /stats) but has no events to match, so /streams stays empty.
STREAM_CONTRACT_ID=CCYM2PIMNHOJKWRV677QQNFUMNU2JKEHXTQKK6D3D7JF2UTEB5JNINYY

# Socket address the HTTP server binds to.
BIND_ADDR=0.0.0.0:8080

# How often (in seconds) the background indexer polls Soroban RPC.
POLL_INTERVAL_SECS=10

# Browser origins allowed to call the API, comma separated, e.g.
# "https://app.example,https://staging.example". Leave unset (or "*") to allow
# any origin -- safe here because the API is read-only and uses no cookies.
# CORS_ALLOWED_ORIGINS=

# Log verbosity, passed straight to tracing-subscriber's EnvFilter, e.g.
# "info", "debug", or "stellar_stream_hive_api=debug,tower_http=debug".
RUST_LOG=info
